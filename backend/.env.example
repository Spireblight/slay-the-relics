# Twitch Extension / Application credentials (required for local Twitch auth & PubSub)
CLIENT_ID=
CLIENT_SECRET=
OWNER_USER_ID=
EXTENSION_SECRET=

# Local server & Redis settings
LISTEN_ADDR=:8888
PPROF_ADDR=:8081
REDIS_ADDR=localhost:6379

# Optional: set to "true" to skip Redis auth checks on POST /api/v2/game-state
DEV_MODE=false

# Broadcast transport: "sse" (local browser stream) or "twitch" (real Twitch PubSub)
# `make dev` overrides this to "sse" by default; use `make dev-twitch` for Twitch PubSub.
PUBSUB_MODE=sse
